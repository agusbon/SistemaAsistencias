@model IEnumerable<ISFDyT124.DTO.UsuarioDetalleDto>
@{
    ViewData["Title"] = "Toma de Asistencia";
    ViewData["BodyClass"] = "asistencia-page";

    var existentes = ViewBag.AsistenciasExistentes as Dictionary<int, ISFDyT124.DTO.AsistenciaDetalleDto>
                     ?? new Dictionary<int, ISFDyT124.DTO.AsistenciaDetalleDto>();
    int maId = (int)(ViewBag.MateriaId ?? 0);
    var fecha = (DateTime)(ViewBag.Fecha ?? DateTime.Today);
}

@* Réplica dinámica de Views/Home/Asistencia.cshtml (mismas clases: attendance-table,
   custom-checkbox, justification-cell, btn-guardar, info-banner) integrada al _Layout. *@

<main class="main-container-asistencia">

    <div id="offlinePendientesBanner" class="offline-pendientes-banner" hidden>
        <span id="offlinePendientesTexto"></span>
        <button type="button" id="offlineSincronizarBtn" class="btn-sincronizar-offline">Sincronizar ahora</button>
    </div>

    <div class="info-banner">
        <div class="info-col-left">
            <p>@fecha.ToString("dd/MM/yyyy")</p>
            <p class="info-bold">@ViewBag.CarreraNombre</p>
        </div>
        <div class="info-col-right">
            <p class="info-bold">@User.Identity?.Name</p>
            <p class="info-bold">@ViewBag.MateriaNombre</p>
        </div>
    </div>

    <form asp-action="Asistencia" method="post" id="formAsistencia" data-offline-asistencia="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maId" value="@maId" />
        <input type="hidden" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" />

        <div class="table-container">
            <table class="attendance-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">Apellido y Nombre</th>
                        <th style="width: 25%; text-align: center;">Presente</th>
                        <th style="width: 25%; text-align: center;">Justificación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 0;
                        foreach (var alumno in Model)
                        {
                            var presente = existentes.ContainsKey(alumno.UsId) && existentes[alumno.UsId].AsPresente;
                            var justificado = existentes.ContainsKey(alumno.UsId) && existentes[alumno.UsId].AsJustificacion;
                            <tr>
                                <td>@alumno.UsApellido, @alumno.UsNombre</td>
                                <td class="modules-cell" style="text-align: center;">
                                    <input type="hidden" name="asistencias[@i].UsId" value="@alumno.UsId" />
                                    <input type="checkbox" class="custom-checkbox"
                                           name="asistencias[@i].AsPresente" value="true" @(presente ? "checked" : "") />
                                </td>
                                <td class="justification-cell" style="text-align: center;">
                                    <input type="checkbox" class="custom-checkbox"
                                           name="asistencias[@i].AsJustificacion" value="true" @(justificado ? "checked" : "") />
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align:center;">No hay alumnos inscriptos en esta cátedra.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn-guardar">Guardar Asistencia</button>
    </form>
</main>

@section Scripts {
    <script src="~/lib/dexie/dist/dexie.min.js"></script>
    <script src="~/js/offline-asistencia.js" asp-append-version="true"></script>
    <script>
        // Frente 7 (PWA offline): si no hay señal al guardar, encola en IndexedDB en vez de
        // mandar el formulario. Con señal, el comportamiento de siempre no cambia en nada.
        (function () {
            var form = document.getElementById('formAsistencia');
            var maId = @maId;
            var fecha = '@fecha.ToString("yyyy-MM-dd")';

            function actualizarBannerPendientes(sesionVencida) {
                if (!window.OfflineAsistencia) return;
                window.OfflineAsistencia.contarPendientes().then(function (n) {
                    var banner = document.getElementById('offlinePendientesBanner');
                    var texto = document.getElementById('offlinePendientesTexto');
                    var btn = document.getElementById('offlineSincronizarBtn');
                    if (!banner || !texto) return;
                    if (n === 0) {
                        banner.hidden = true;
                        return;
                    }
                    banner.hidden = false;
                    if (sesionVencida) {
                        // 7.1.6: nada de lo cargado se pierde — solo hace falta volver a
                        // loguearse para que el servidor acepte la sincronización de nuevo.
                        texto.textContent = 'Tu sesión venció mientras estabas sin conexión. ' +
                            'Iniciá sesión de nuevo — lo que ya cargaste no se perdió, ' +
                            'queda guardado en este dispositivo (' + n + (n === 1 ? ' pendiente' : ' pendientes') + ').';
                        if (btn) { btn.textContent = 'Iniciar sesión'; btn.dataset.sesionVencida = 'true'; }
                    } else {
                        texto.textContent = n + (n === 1
                            ? ' asistencia pendiente de sincronizar'
                            : ' asistencias pendientes de sincronizar');
                        if (btn) { btn.textContent = 'Sincronizar ahora'; delete btn.dataset.sesionVencida; }
                    }
                });
            }

            window.addEventListener('offline-asistencia:sync', function (e) {
                actualizarBannerPendientes(e.detail && e.detail.sesionVencida);
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (navigator.onLine || !window.OfflineAsistencia) return; // caso normal, sin cambios

                    e.preventDefault();

                    var filas = [];
                    form.querySelectorAll('tbody tr').forEach(function (tr) {
                        var usIdInput = tr.querySelector('input[name$=".UsId"]');
                        if (!usIdInput) return;
                        var presenteInput = tr.querySelector('input[name$=".AsPresente"]');
                        var justificacionInput = tr.querySelector('input[name$=".AsJustificacion"]');
                        filas.push({
                            usId: parseInt(usIdInput.value, 10),
                            presente: !!(presenteInput && presenteInput.checked),
                            justificacion: !!(justificacionInput && justificacionInput.checked),
                        });
                    });

                    if (filas.length === 0) return;

                    window.OfflineAsistencia.encolarAsistencia(maId, fecha, filas).then(function () {
                        alert('Sin conexión: la asistencia se guardó en este dispositivo y se va a enviar sola cuando vuelva la señal.');
                        actualizarBannerPendientes();
                    });
                });
            }

            var btnSync = document.getElementById('offlineSincronizarBtn');
            if (btnSync) {
                btnSync.addEventListener('click', function () {
                    // Sesión vencida (7.1.6): reintentar el POST solo repite el mismo 401 —
                    // hay que loguearse de nuevo primero, la cola espera intacta hasta entonces.
                    if (btnSync.dataset.sesionVencida === 'true') {
                        window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                        return;
                    }
                    if (!window.OfflineAsistencia) return;
                    btnSync.disabled = true;
                    // El estado del banner lo actualiza el listener de 'offline-asistencia:sync'
                    // (dispara siempre, venga de este click o de una sincronización automática);
                    // acá solo hace falta reactivar el botón al terminar.
                    window.OfflineAsistencia.sincronizarPendientes().finally(function () {
                        btnSync.disabled = false;
                    });
                });
            }

            actualizarBannerPendientes();
        })();
    </script>
}
