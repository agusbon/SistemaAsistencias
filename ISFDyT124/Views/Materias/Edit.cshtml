@model ISFDyT124.Models.Materia

@{
    ViewData["Title"] = "Modificar Materia";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Modificar Materia</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <form asp-action="Edit" class="form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaId" />

            <div class="input-field">
                <label asp-for="MaDenominacion"></label>
                <input asp-for="MaDenominacion" autocomplete="off">
                <span asp-validation-for="MaDenominacion" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="MaModalidad"></label>
                <select asp-for="MaModalidad">
                    <option value="">-- Seleccione una modalidad --</option>
                    <option value="Presencial">Presencial</option>
                    <option value="Virtual">Virtual</option>
                    <option value="Libre">Libre</option>
                    <option value="Semipresencial">Semipresencial</option>
                </select>
                <span asp-validation-for="MaModalidad" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="MaCantModulos"></label>
                <input asp-for="MaCantModulos" type="number" min="1" max="4">
                <span asp-validation-for="MaCantModulos" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="MaPorcentajeAsistenciaMinima"></label>
                <input asp-for="MaPorcentajeAsistenciaMinima" type="number" min="0" max="100">
                <span asp-validation-for="MaPorcentajeAsistenciaMinima" class="text-danger"></span>
            </div>

            <div class="form-buttons" style="grid-column: span 2;">
                <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Actualizar Materia</button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
